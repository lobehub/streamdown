{
  "name": "@lobehub/streamdown",
  "version": "1.2.0",
  "description": "Headless streaming markdown engine for React: block splitting, smooth reveal, per-char fade animation and LLM output preprocessing",
  "homepage": "https://streamdown.lobehub.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lobehub/streamdown.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./es/index.d.mts",
      "import": "./es/index.mjs",
      "default": "./es/index.mjs"
    },
    "./profiler": {
      "types": "./es/profiler/index.d.mts",
      "import": "./es/profiler/index.mjs"
    }
  },
  "main": "./es/index.mjs",
  "types": "./es/index.d.mts",
  "files": [
    "es"
  ],
  "scripts": {
    "build": "tsdown",
    "build:site": "pnpm --filter @lobehub/streamdown-site run build",
    "deploy:site": "pnpm --filter @lobehub/streamdown-site run deploy",
    "dev": "pnpm --filter @lobehub/streamdown-site run dev",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "prepublishOnly": "npm run build",
    "prepare": "husky",
    "release": "semantic-release",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit && tsc --noEmit -p site/tsconfig.json"
  },
  "dependencies": {
    "@types/hast": "^3.0.5",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "html-url-attributes": "^3.0.1",
    "katex": "^0.18.1",
    "marked": "^18.0.6",
    "react-markdown": "^10.1.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remend": "^1.3.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@lobehub/lint": "^2.1.5",
    "@testing-library/react": "^16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/unist": "^3.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "conventional-changelog-gitmoji-config": "1.5.2",
    "eslint": "^9.39.5",
    "eslint-plugin-sort-keys-fix": "^1.1.2",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "semantic-release": "^25.0.6",
    "tsdown": "^0.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.18.0",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  }
}
