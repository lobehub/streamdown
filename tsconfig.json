{
  "compilerOptions": {
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@lobehub/streamdown": ["./src"],
      "@lobehub/streamdown/*": ["./src/*"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "es2020",
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "exclude": [".react-router", "dist", "es"],
  "include": ["src", "docs", "docs.config.ts", "tsdown.config.ts", "vitest.config.ts"]
}
